    "videoUrl": "https://scontent-gmp1-1.cdninstagram.com/o1/v/t2/f2/m86/AQPPjJMf73X7IxTMXmVZFeD7gKFTvhYCJQal1P9HAlToM8BnLNGOn7akILpaBw1Q4so2D-eC2jLB7G6se15xQM3F6us39DGn9RW0omE.mp4?_nc_cat=111&_nc_sid=5e9851&_nc_ht=scontent-gmp1-1.cdninstagram.com&_nc_ohc=zl2DkQ3dVL8Q7kNvwFhNxLr&efg=eyJ2ZW5jb2RlX3RhZyI6Inhwdl9wcm9ncmVzc2l2ZS5JTlNUQUdSQU0uQ0xJUFMuQzMuNzIwLmRhc2hfYmFzZWxpbmVfMV92MSIsInhwdl9hc3NldF9pZCI6MTI2NTA0ODYwNTUwMDMxMywiYXNzZXRfYWdlX2RheXMiOjk5LCJ2aV91c2VjYXNlX2lkIjoxMDA5OSwiZHVyYXRpb25fcyI6ODYsInVybGdlbl9zb3VyY2UiOiJ3d3cifQ%3D%3D&ccb=17-1&vs=198e6c960495070b&_nc__BBUCKAJDMywXQFWCHKwIMScYEmRhc2hfYmFzZWxpbmVfMV92MREAdf4HZeadAQA&_nc_gid=YIEseE57_EiS8hgwg9I7LQ&_nc_ss=7a22e&_nc_zt=28&oh=00_AQLkBgdrOZS9CA15_jX7JYWQGNDGvchRv8EJc57P2PPV0w&oe=6AB6A7FC",
    "timestamp": "2026-06-16T11:00:39.000Z",
    "videoViewCount": null,
    "videoPlayCount": 1538,
