    "videoUrl": "https://scontent-waw2-2.cdninstagram.com/o1/v/t2/f2/m86/AQOOkoEqQ54zT1SB0E5CmTbIA2_IFluhhuafB1dJOO5mlLdh53lHGV6GrvZIXvEpg9xAgFp9RsG6OuT0j5qcYh8-qmTHZ0K-84RgW0o.mp4?_nc_cat=101&_nc_sid=5e9851&_nc_ht=scontent-waw2-2.cdninstagram.com&_nc_ohc=f2mRWD-cJ7oQ7kNvwHMj6yJ&efg=eyJ2ZW5jb2RlX3RhZyI6Inhwdl9wcm9ncmVzc2l2ZS5JTlNUQUdSQU0uQ0xJUFMuQzMuNzIwLmRhc2hfYmFzZWxpbmVfMV92MSIsInhwdl9hc3NldF9pZCI6MTgwMTE3OTUyNTg5MDgwNDgsImFzc2V0X2FnZV9kYXlzIjo5OSwidmlfdXNlY2FzZV9pZCI6MTAwOTksImR1cmF0aW9uX3MiOjEzNCwidXJsZ2VuX3NvdXJjZSI6Ind3dyJ9&ccb=17-1&vs=d77a218bfbd5a655&_nc_-PxUCKAJDMywXQGDCHKwIMScYEmRhc2hfYmFzZWxpbmVfMV92MREAdf4HZeadAQA&_nc_gid=n01KGbfe_I714oFApfW0jg&_nc_ss=7a22e&_nc_zt=28&oh=00_AQPiqUwSNJxxf1DOSBa30AZ-T8ngRi8Xi935jKih96Rusg&oe=6ABE3DBE",
    "timestamp": "2026-06-22T13:36:46.000Z",
    "videoViewCount": null,
